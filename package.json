{
  "name": "aecodezonebg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/check-live.ts && tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "screenshots": "tsx scripts/screenshots.ts",
    "shots:review": "tsx scripts/review-shots.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "brand": "tsx scripts/brand-assets.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "videos": "tsx scripts/videos.ts",
    "check-live": "tsx scripts/check-live.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^5.4.21"
  }
}
